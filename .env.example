DATABASE_URL=sqlite:///./aurora.db
BANK_CORE_URL=http://localhost:8100
MCP_SERVER_URL=http://localhost:8101/mcp
MCP_BEARER_TOKEN=local-demo-mcp-secret
OPENAI_API_KEY=
OPENAI_URL=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=
# Agent URL variables belong in the independently deployed Agent Manager
# Concierge and Portal environments, NOT in this local Docker Compose .env.
# Local Compose always uses service DNS (http://account:8200, etc.) even if
# an old .env from a previous demo still defines localhost URLs.

# MCP Python SDK host validation. Keep DNS rebinding protection enabled.
# For on-prem deployments, replace/extend the allowlist with actual upstream DNS names.
MCP_ALLOWED_HOSTS=mcp:*,localhost:*,127.0.0.1:*
MCP_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

# Gateway routing: set these when UI/BFF connects to deployed Agent Manager.
# Use the actual Invoke URL from each Custom API Agent deployment.
WSO2_MODE=false
CONCIERGE_API_KEY=
AGENT_ACCOUNT_API_KEY=
AGENT_CARD_API_KEY=
AGENT_DISPUTE_API_KEY=
AGENT_PIX_API_KEY=
AGENT_WELLNESS_API_KEY=
# For specialists: MCP_SERVER_URL is injected by MCP Proxy tool configuration.
# Identity-secured OAuth (preferred): agentid. API-key-only: apikey. Docker: local.
MCP_AUTH_MODE=local
MCP_PROXY_API_KEY=
MCP_API_KEY_HEADER=X-API-Key

# Local-demo defaults below MUST be replaced before any shared/network deployment.
BANK_CORE_READ_KEY=local-demo-read-only
BANK_CORE_WRITE_KEY=local-demo-write-mcp
BANK_APPROVAL_KEY=local-demo-approval-core
SPECIALIST_EXECUTION_KEY=local-demo-specialist-execute
CONCIERGE_APPROVAL_KEY=local-demo-concierge-approval
BANK_RESET_KEY=local-demo-reset-capability
DEMO_ACCESS_CODE=aurora-local-demo-only
DEMO_RESET_CODE=local-presenter-reset
DEMO_SESSION_SIGNING_KEY=local-development-cookie-key-not-for-public-deployment
DEMO_SECURE_COOKIE=false
AURORA_ENABLE_OTEL=false
POLICY_INDEX_PATH=/tmp/aurora-policy-index.sqlite
CONCIERGE_CALL_KEY=local-demo-concierge-call
SPECIALIST_CALL_KEY=local-demo-specialist-call
# HTTPS reverse proxy public origin, when different from request.base_url
DEMO_PUBLIC_ORIGIN=
