# Copy to support.env (gitignored in your repo), then run ./start.sh
# Deployment target: kubernetes (recommended; same cluster as AMP gateway) or docker
DEPLOY_TARGET=kubernetes

# REQUIRED for Kubernetes. Use `kubectl config current-context`.
KUBE_CONTEXT=REPLACE_WITH_YOUR_KUBECTL_CONTEXT
KUBE_NAMESPACE=aurora-demo
# Image must be pullable by Kubernetes nodes. You may let start.sh build/push it.
# For an Agent Manager local quick-start k3d cluster, k3d mode builds and
# imports the image automatically. No container registry is needed.
IMAGE_DELIVERY=k3d
K3D_CLUSTER=amp-local
AURORA_IMAGE=aurora-banking-support:amp-v4
# For managed Kubernetes: IMAGE_DELIVERY=registry; set AURORA_IMAGE to your
# accessible registry image. Set BUILD_AND_PUSH=true if Docker can push it.
BUILD_AND_PUSH=false

# Docker-only: runs PostgreSQL + Core + MCP on your Mac; nothing public by default.
HOST_CORE_PORT=8110
HOST_MCP_PORT=8111
HOST_PORTAL_PORT=8330
MCP_HOST_BIND=127.0.0.1
# Add the real private ingress/upstream host (if used) to the MCP host allowlist.
MCP_ALLOWED_HOSTS=mcp:*,localhost:*,127.0.0.1:*,aurora-mcp:*,aurora-mcp.aurora-demo.svc.cluster.local:*
MCP_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

# Agent Manager: set AMP_PUBLISH=false to launch backend without registering proxy.
AMP_PUBLISH=true
AMP_ORG=default
AMP_ENVIRONMENT_HANDLE=default
# Optional: publisher attempts to resolve UUID from AMP_ENVIRONMENT_HANDLE.
# If your installation uses a different environment API response, set manually.
AMP_ENVIRONMENT_UUID=
AMP_PROXY_ID=aurora-banking
AMP_CREATE_ROLES=true
# Must be reachable from AMP's control plane AND AI gateway.
# In same-cluster Kubernetes this may be omitted and is inferred automatically.
# In Docker mode you MUST set a real PRIVATE routed URL; localhost is invalid.
AURORA_MCP_UPSTREAM_URL=

# Portal is optional until Concierge has been deployed. To enable later:
PORTAL_ENABLED=false
# Set these in secrets.env after Concierge deployment, not in this file:
# CONCIERGE_URL=https://... (base invoke URL)
# CONCIERGE_API_KEY=...
