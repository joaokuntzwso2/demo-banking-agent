# Optional simple demo alternative, DOES NOT give per-tool governance by itself.
WSO2_MODE=true
MCP_AUTH_MODE=apikey
# MCP_SERVER_URL and MCP_PROXY_API_KEY injected from attached MCP proxy.
# Make sure proxy configuration names exactly match this code.
MCP_API_KEY_HEADER=X-API-Key
BANK_INTERNAL_KEY=REPLACE_WITH_SECRET
