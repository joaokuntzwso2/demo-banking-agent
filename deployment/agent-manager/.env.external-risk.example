# Optional externally hosted Risk Advisor. Configure its MCP tool authorization manually.
AGENT_ROLE=risk
WSO2_MODE=true
MCP_SERVER_URL=https://YOUR_MCP_PROXY_GATEWAY/mcp
MCP_AUTH_MODE=apikey
MCP_PROXY_API_KEY=REPLACE_WITH_EXTERNAL_RISK_GATEWAY_KEY
MCP_API_KEY_HEADER=X-API-Key
SPECIALIST_CALL_KEY=REPLACE_WITH_CONCIERGE_TO_SPECIALIST_SECRET
# For OAuth mode, use a real external AgentID credential configuration per AMP docs instead.
AGENT_VERSION=executive-v3
