# Copy this as a reference for EACH specialist in the AMP Console.
# AGENT_ROLE is set automatically by that specialist's generated main.py.
WSO2_MODE=true
MCP_AUTH_MODE=agentid
# MCP_SERVER_URL is INJECTED by Agent Manager's MCP tool configuration.
# Configure its variable name to MCP_SERVER_URL; NEVER point to the upstream service.
# AMP_AGENTID_CLIENT_ID / AMP_AGENTID_CLIENT_SECRET / AMP_AGENTID_TOKEN_ENDPOINT
# and AMP_AGENTID_SCOPES are injected by AMP; do not configure them manually.
SPECIALIST_CALL_KEY=REPLACE_WITH_CONCIERGE_TO_SPECIALISTS_SECRET
SPECIALIST_EXECUTION_KEY=REPLACE_WITH_CONCIERGE_TO_EXECUTE_SECRET_FOR_WRITE_SPECIALISTS
# Attach managed LLM provider to Dispute/Wellness only when used for models.
USE_LLM_PROVIDER=true
REQUIRE_GOVERNED_LLM=true
# Provider URL/key injected by Agent Manager; optional for deterministic RAG.
OPENAI_MODEL=gpt-4.1-mini
AGENT_VERSION=executive-v4
OPENAI_EMBEDDING_MODEL=

# Dispute and Wellness: enable when the LLM provider is attached and tested.
LLM_GROUNDED_ANSWERS=true
# Optional pinned evidence date. Leave unset to use current runtime date.
POLICY_AS_OF_DATE=
# Embeddings require a separately governed endpoint if available; by default
# use persistent FTS5 and do not configure OPENAI_API_KEY on hosted agents.
EMBEDDING_PROVIDER_URL=
EMBEDDING_PROVIDER_KEY=
