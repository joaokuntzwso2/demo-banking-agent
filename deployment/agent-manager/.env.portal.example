# Keep this on the Banking Portal / BFF host, NOT in the browser.
# This deployment reads status directly from the Banking Core but all chat,
# approvals, specialist invocations and readback route through Aurora Concierge.
WSO2_MODE=true
BANK_CORE_URL=http://aurora-core.aurora-demo.svc.cluster.local:8100
BANK_INTERNAL_KEY=REPLACE_WITH_THE_SAME_INTERNAL_KEY_USED_BY_BANKING_CORE_AND_AGENTS
# Demo frontend is hardwired to this synthetic token, not production auth.
DEMO_SESSION_TOKEN=local-demo-session
CONCIERGE_URL=https://YOUR_AGENT_MANAGER_INVOKE_HOST/PATH/TO/aurora-concierge
CONCIERGE_API_KEY=REPLACE_WITH_API_KEY_CREATED_FOR_CONCIERGE_ENDPOINT
