# Keep this on the Banking Portal / BFF host, NOT in the browser.
# This deployment reads status directly from the Banking Core but all chat,
# approvals, specialist invocations and readback route through Aurora Concierge.
WSO2_MODE=true
BANK_CORE_URL=http://aurora-core.aurora-demo.svc.cluster.local:8100
BANK_CORE_READ_KEY=REPLACE_WITH_CORE_READ_SECRET
# Required by hybrid Compose core/mcp services (NOT needed in the portal process):
BANK_CORE_WRITE_KEY=REPLACE_WITH_CORE_WRITE_SECRET
BANK_APPROVAL_KEY=REPLACE_WITH_CORE_APPROVAL_SECRET
BANK_RESET_KEY=REPLACE_WITH_PRESENTER_RESET_SECRET
CONCIERGE_CALL_KEY=REPLACE_WITH_BFF_TO_CONCIERGE_SECRET
CONCIERGE_APPROVAL_KEY=REPLACE_WITH_BFF_TO_CONCIERGE_APPROVAL_SECRET
# Browser gets a signed HttpOnly cookie on entering access code.
DEMO_ACCESS_CODE=REPLACE_WITH_A_PRIVATE_DEMO_ACCESS_CODE
DEMO_RESET_CODE=REPLACE_WITH_DISTINCT_PRIVATE_RESET_CODE
DEMO_SESSION_SIGNING_KEY=REPLACE_WITH_64_RANDOM_HEX_OR_BETTER
DEMO_SECURE_COOKIE=true
CONCIERGE_URL=https://YOUR_AGENT_MANAGER_INVOKE_HOST/PATH/TO/aurora-concierge
CONCIERGE_API_KEY=REPLACE_WITH_API_KEY_CREATED_FOR_CONCIERGE_ENDPOINT

# For the separate presenter case queue (do not expose this capability to agents).
BANK_CASE_OPERATOR_KEY=REPLACE_WITH_CORE_OPERATOR_SECRET
DEMO_OPERATOR_CODE=REPLACE_WITH_SEPARATE_PRESENTER_OPERATOR_CODE
