# Set for the platform-hosted aurora-concierge deployment (AMP Console).
WSO2_MODE=true
AGENT_ROLE=concierge
BANK_CORE_URL=http://aurora-core.aurora-demo.svc.cluster.local:8100
BANK_INTERNAL_KEY=REPLACE_WITH_SECRET_MATCHING_CORE_AND_SPECIALISTS
AGENT_ACCOUNT_URL=https://YOUR_AGENT_MANAGER_INVOKE_HOST/PATH/TO/aurora-account
AGENT_ACCOUNT_API_KEY=SECRET_ACCOUNT_GATEWAY_KEY
AGENT_CARD_URL=https://YOUR_AGENT_MANAGER_INVOKE_HOST/PATH/TO/aurora-card
AGENT_CARD_API_KEY=SECRET_CARD_GATEWAY_KEY
AGENT_DISPUTE_URL=https://YOUR_AGENT_MANAGER_INVOKE_HOST/PATH/TO/aurora-dispute
AGENT_DISPUTE_API_KEY=SECRET_DISPUTE_GATEWAY_KEY
AGENT_PIX_URL=https://YOUR_AGENT_MANAGER_INVOKE_HOST/PATH/TO/aurora-pix
AGENT_PIX_API_KEY=SECRET_PIX_GATEWAY_KEY
AGENT_WELLNESS_URL=https://YOUR_AGENT_MANAGER_INVOKE_HOST/PATH/TO/aurora-wellness
AGENT_WELLNESS_API_KEY=SECRET_WELLNESS_GATEWAY_KEY
OPENAI_API_KEY=REPLACE_OR_USE_GOVERNED_LLM_PROVIDER
OPENAI_MODEL=gpt-4.1-mini
OPENAI_URL=
# The Concierge itself needs NO Banking MCP Proxy binding.
